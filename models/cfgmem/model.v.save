// Add 1x2 binary decoder
`default_nettype none

// 16 x 32 Config MEM
module CFGMEM16
#(
    parameter WSIZE = 32,
    parameter COUNT = 16
 )
(
    input   wire                 CLK,
    input   wire                 WE0,
    input                        EN0,
    input   wire [3:0]           A0,
    input   wire [31:0]          Di0,
    output  wire [31:0]          Do0
    
);
//    wire [1:0]           SEL0;
    wire [15:0]          SEL1;
    wire [15:0]          SEL1_BUF;
    wire [15:0]          LE0;
    wire [15:0]          LE0_pre;
    wire [3:0]           A0_buf;
    wire                 CLK_buf;
    wire                 EN0_buf;
    wire                 WE0_DLY;

    wire [31:0]          Di0_in[15:0];
    wire [31:0]          Do0_pre[15:0];
    wire [31:0]          Do1_pre0[3:0];
    wire [31:0]          Do1_pre[3:0];

`ifndef NO_DIODES   
    (* keep = "true" *)
    DIODE    DIODE_CLK         (.DIODE(CLK));
    (* keep = "true" *)
    DIODE    DIODE_A0 [3:0]    (.DIODE(A0[3:0]));
`endif
    
    CLKBUF_4   CLKBUF          (.X(CLK_buf), .A(CLK));
    CLKBUF_2   A0BUF[3:0]      (.X(A0_buf),  .A(A0[3:0]));
//    CLKBUF_2   EN0BUF          (.X(EN0_buf), .A(EN0));

    DEC4x16 DEC0 (.EN(EN0), .A(A0_buf), .SEL(SEL1));
    
    // Create CFG_WORDs for all 16 rows
    assign Di0_in[0] = Di0;
    generate
        genvar i;
        for (i=1; i< 16; i=i+1) begin : IN_MAP
            assign Di0_in[i] = Do0_pre[i-1];
        end

        // Create 16 rows of WORDS plus SEL buffers with protection diodes.
        for (i=0; i< 16; i=i+1) begin : SLICE
            CFG_WORD CWORD (.LE0(LE0[i]), .Di0(Di0_in[i]), .Do0(Do0_pre[i]) ); 
            sky130_fd_sc_hd__clkbuf_4 SELBUF (.X(SEL1_BUF[i]), .A(SEL1[i]));
            sky130_fd_sc_hd__diode_2 DIODE_SEL1 (.DIODE(SEL1_BUF[i]));
        end
    endgenerate

    // Create 4 aggregator circuts for each group of 4 WORDS using an a222oi
    // and an a21boi.  This result in 1 signal that must feed into a 4-input
    // NAND somewhere.
    //
    // a222oi: Y = !((A1 & A2) | (B1 & B2) | (C1 & C2))
    // a21boi: Y = !((A1 & A2) | (!B1_N))
    generate
        genvar q;
        for (q = 0; q < 4; q=q+1) begin : QUADS
            for (i = 0; i < 32; i=i+1) begin : QBIT
                sky130_fd_sc_hd__a222oi_1 QUAD_A222OI (
                      .A1 (Do0_pre[q*4  + 1][i]),
                      .B1 (Do0_pre[q*4  + 2][i]),
                      .C1 (Do0_pre[q*4  + 3][i]),
                      .A2 (SEL1_BUF[q*4 + 1]),
                      .B2 (SEL1_BUF[q*4 + 2]),
                      .C2 (SEL1_BUF[q*4 + 3]),
                      .Y  (Do1_pre0[q][i])
                );
                sky130_fd_sc_hd__a21boi_1 QUAD_A21BOI (
                      .A1   (Do0_pre[q*4  + 0][i]),
                      .A2   (SEL1_BUF[q*4 + 0]),
                      .B1_N (Do1_pre0[q][i]),
                      .Y    (Do1_pre[q][i])
                );
            end
        end

        for (i = 0; i < 32; i=i+1) begin : OUT_NAND
            // Create final outputs
            sky130_fd_sc_hd__nand4_2 QUAD_NAND
            (
                .A(Do1_pre[0][i]),
                .B(Do1_pre[1][i]),
                .C(Do1_pre[2][i]),
                .D(Do1_pre[3][i]),
                .Y(Do0[i])
            );
        end
    endgenerate

    wire        WE0_PULSE;
    wire [15:0] shift_latch_in;
    wire [15:0] shift_latch_out;
    wire [15:0] shift_le;
    assign shift_latch_in[15] = WE0_PULSE;
    generate
        for (i = 0; i < 15; i = i + 1) begin : GEN_SHIFT
            assign shift_latch_in[i] = shift_latch_out[i+1];
        end
    endgenerate

    // Flop for rising edge detect on WE0
    sky130_fd_sc_hd__dfxtp_1 WE_P2
    (
        .CLK ( CLK_buf ),
        .D   ( WE0     ),
        .Q   ( WE0_DLY )
    );
    // Rising edge detect for WE0
    sky130_fd_sc_hd__and2b_1 WE_EDGE
    (
        .A_N ( WE0_DLY   ),
        .B   ( WE0       ),
        .X   ( WE0_PULSE )
    );
    // Create the latch shift-register flops and clock gates.  This uses 16
    // clocks to successive shift a column (32-bit word) of latch values through 16
    // rows by latching row 15 from 14 first, then 14 from 13, etc.
    generate
        for (i = 0; i < 16; i = i + 1) begin : ONEHOT
            sky130_fd_sc_hd__dfxtp_1 SHIFT_BIT
            (
                .CLK ( CLK_buf            ),
                .D   ( shift_latch_in[i]  ),
                .Q   ( shift_latch_out[i] )
            );
            sky130_fd_sc_hd__dlclkp_4 SHIFT_GCLK
            (
                .CLK  ( CLK_buf            ),
                .GATE ( shift_latch_out[i] ),
                .GCLK ( LE0[i]             )
            );
        end
    endgenerate

endmodule

