      "lef":  ["dir::../products/CFGMEM_IHP16/lef/CFGMEM_IHP16.lef"],
      "nl":   ["dir::../products/CFGMEM_IHP16/nl/CFGMEM_IHP16.nl.v"],
      "spef": { "nom_*": ["dir::../products/CFGMEM_IHP16/spef/nom/CFGMEM_IHP16.nom.spef"] },
      "lib": {
        "nom_typ_1p20V_25C":  ["dir::../products/CFGMEM_IHP16/lib/nom_typ_1p20V_25C/CFGMEM_IHP16__nom_typ_1p20V_25C.lib"],
        "nom_fast_1p32V_m40C": ["dir::../products/CFGMEM_IHP16/lib/nom_fast_1p32V_m40C/CFGMEM_IHP16__nom_fast_1p32V_m40C.lib"],
        "nom_slow_1p08V_125C": ["dir::../products/CFGMEM_IHP16/lib/nom_slow_1p08V_125C/CFGMEM_IHP16__nom_slow_1p08V_125C.lib"]
      }
