    [0, 71.82, 51.44, 166.32],
    [382.64, 71.82, 419.52, 166.32]
  ],
  "ROUTING_OBSTRUCTIONS": [
    ["Metal2", 0, 75.6, 51.44, 162.54],
    ["Metal4", 0, 75.6, 51.44, 162.54],
    ["Metal2", 382.64, 75.6, 419.52, 162.54],
    ["Metal4", 382.64, 75.6, 419.52, 162.54]
  ],

  "//": "Macro at x = 1.44 + 50 so its Metal4 stripes coincide with the tile grid; y on a row boundary",
  "FP_MACRO_HORIZONTAL_HALO": 3,
  "FP_MACRO_VERTICAL_HALO": 3,
  "PDN_MACRO_CONNECTIONS": ["cfgmem VPWR VGND VPWR VGND"],
  "MACROS": {
    "CFGMEM_IHP16": {
