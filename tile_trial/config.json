{
  "DESIGN_NAME": "tt_um_cfgmem_trial",
  "VERILOG_FILES": ["dir::src/tt_um_cfgmem_trial.v"],
  "CLOCK_PORT": "clk",
  "CLOCK_PERIOD": 20,

  "//": "Tiny Tapeout CMOS5L 2x2 tile (tt-support-tools ihp-sg13cmos5l branch)",
